{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022", "DOM"],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "strict": true,
    "noEmit": true,
    "esModuleInterop": true,
    "forceConsistentCasingInFileNames": true,
    "skipLibCheck": true,
    /* @writtendev/ui's barrel re-exports .tsx source (WRTN-39). tsc
       follows the barrel into it while typechecking main.ts's import, so
       this package needs a JSX setting even though nothing under
       web/src/ is itself JSX. */
    "jsx": "react-jsx"
  },
  "include": ["src", "vite.config.ts"]
}
