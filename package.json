{
  "name": "written-monorepo",
  "private": true,
  "type": "module",
  "description": "Workspace root for written's TypeScript half (ui, web). The Go module at the repo root is unrelated to npm and is built and tested through the Makefile.",
  "engines": {
    "node": ">=22.18"
  },
  "workspaces": [
    "ui",
    "web"
  ],
  "scripts": {
    "typecheck": "make check-ts",
    "build": "make build-ts",
    "lint": "eslint . --max-warnings 0",
    "format": "prettier --write $(node -pe \"require('./package.json').workspaces.join(' ')\") package.json eslint.config.js .prettierrc.json",
    "format:check": "prettier --check $(node -pe \"require('./package.json').workspaces.join(' ')\") package.json eslint.config.js .prettierrc.json"
  },
  "devDependencies": {
    "@eslint/compat": "^2.1.1",
    "@eslint/js": "^10.0.1",
    "eslint": "^10.10.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.6",
    "globals": "^17.12.0",
    "prettier": "^3.9.6",
    "typescript-eslint": "^8.69.0"
  }
}
