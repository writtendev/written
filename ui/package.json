{
  "name": "@writtendev/ui",
  "version": "0.2.0",
  "private": false,
  "description": "Shared component package for written's web client(s). Ships as source: no build script, published to npm as source and consumed directly from src/ by a consumer's bundler (see ARCHITECTURE.md).",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/writtendev/written.git",
    "directory": "ui"
  },
  "homepage": "https://github.com/writtendev/written/tree/main/ui",
  "bugs": "https://github.com/writtendev/written/issues",
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "buildless": true,
  "type": "module",
  "exports": {
    ".": "./src/index.ts",
    "./tokens.css": "./src/tokens.css",
    "./package.json": "./package.json"
  },
  "files": [
    "src"
  ],
  "sideEffects": [
    "**/*.css"
  ],
  "scripts": {
    "dev": "vite",
    "typecheck": "tsc -b --noEmit",
    "build:harness": "tsc -b && vite build"
  },
  "peerDependencies": {
    "react": "^19",
    "react-dom": "^19"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^24.13.3",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@vitejs/plugin-react": "^6.1.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "tailwindcss": "^4.3.3",
    "typescript": "~6.0.2",
    "vite": "^8.2.2"
  }
}
